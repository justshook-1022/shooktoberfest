{
  "name": "shooktoberfest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run design:check && next build --webpack",
    "start": "next start",
    "design:check": "node scripts/check-design-lock.mjs",
    "deployment:check": "node scripts/check-deployment-design.mjs",
    "deploy:preview": "npm run design:check && vercel --force",
    "test": "node --test tests/*.test.mjs",
    "test:db": "supabase test db",
    "test:admin-db": "node --env-file=.env.local scripts/test-admin-database.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test:scoring": "node --env-file=.env.local scripts/test-live-scoring.mjs",
    "test:reset": "node --env-file=.env.local scripts/test-score-reset.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
